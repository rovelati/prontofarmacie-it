---
import type { JobApplicationContact, JobListing } from '@/lib/jobs';
import { buildJobApplicationMailto } from '@/lib/jobs';

interface Props {
  job: JobListing;
  contact: JobApplicationContact;
  compact?: boolean;
}

const { job, contact, compact = false } = Astro.props;
const mailto = contact.email ? buildJobApplicationMailto(job, contact.email) : null;
const hasPhone = Boolean(job.pharmacy?.phone?.replace(/\D/g, ''));
---

<section
  class:list={[
    'rounded-2xl border border-emerald-200 bg-emerald-50/70 dark:border-emerald-700 dark:bg-emerald-950 dark:text-emerald-50',
    compact ? 'p-4' : 'p-5 sm:p-6',
  ]}
>
  <h2
    class:list={[
      'font-semibold text-gray-900 dark:text-emerald-50',
      compact ? 'text-base' : 'text-lg',
    ]}
  >
    Come candidarsi
  </h2>

  {contact.email && mailto ? (
    <>
      <p class="mt-2 text-sm text-gray-700 dark:text-emerald-100/90">
        {contact.emailSource === 'annuncio'
          ? 'Invia il curriculum all\'indirizzo indicato nell\'annuncio:'
          : 'Invia il curriculum all\'indirizzo email associato alla farmacia:'}
      </p>
      <p class="mt-2 break-all text-sm font-semibold text-emerald-800 dark:text-emerald-300">{contact.email}</p>
      <a
        href={mailto}
        class="mt-4 inline-flex rounded-xl bg-emerald-600 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:text-emerald-950"
      >
        Invia CV via email
      </a>
      {contact.emailSource === 'farmacia' && (
        <p class="mt-3 text-xs leading-relaxed text-gray-600 dark:text-emerald-200/80">
          L&apos;indirizzo email proviene dai dati anagrafici della farmacia collegata all&apos;offerta, non dall&apos;annuncio originale.
          Verifica sempre i recapiti sul sito di origine dell&apos;offerta prima di inviare candidature sensibili.
        </p>
      )}
    </>
  ) : (
    <p class="mt-2 text-sm text-gray-700 dark:text-emerald-100/90">
      In questo annuncio non risulta un indirizzo email per le candidature.
      {hasPhone ? ' Puoi contattare la farmacia telefonicamente.' : ' Consulta il testo completo e la fonte originale.'}
    </p>
  )}

  {contact.sourceSiteUrl && contact.sourceSiteLabel && (
    <p class="mt-3 text-xs leading-relaxed text-gray-600 dark:text-emerald-200/80">
      Fonte offerta:
      {' '}
      <a
        href={contact.sourceSiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold text-emerald-700 hover:underline dark:text-emerald-300"
      >
        {contact.sourceSiteLabel}
      </a>
      {job.source_url ? ' — apri l\'annuncio originale.' : ' — verifica sempre l\'annuncio aggiornato sul sito di origine.'}
    </p>
  )}
</section>
