---
import {
  JOB_APPLY_FAQ_HEADING,
  JOB_APPLY_FAQ_ITEMS,
  JOB_APPLY_FAQ_LEAD,
  type JobFaqItem,
} from '@/lib/jobFaq';

interface Props {
  /** FAQ locali (es. città/ruolo); mostrate sopra i consigli di candidatura. */
  localItems?: JobFaqItem[];
  localHeading?: string;
  localLead?: string;
}

const {
  localItems = [],
  localHeading = 'Domande frequenti su questa ricerca',
  localLead = 'Risposte rapide per chi sta cercando lavoro in farmacia in questa zona.',
} = Astro.props;
---

{localItems.length > 0 && (
  <section
    class="mt-10 rounded-2xl border border-emerald-100 bg-gradient-to-br from-emerald-50/80 via-white to-sky-50/60 p-6 sm:p-8"
    aria-labelledby="job-local-faq-heading"
  >
    <h2 id="job-local-faq-heading" class="text-xl font-bold text-gray-900 sm:text-2xl">
      {localHeading}
    </h2>
    <p class="mt-2 max-w-3xl text-sm leading-6 text-gray-600">{localLead}</p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {localItems.map((item, index) => (
        <li class="flex h-full flex-col rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm">
          <span
            class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-emerald-600 text-sm font-bold text-white"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <h3 class="text-base font-semibold leading-snug text-gray-900">{item.question}</h3>
          <p class="mt-2 text-sm leading-6 text-gray-600">{item.answer}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<section
  class="mt-10 rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-50/80 via-white to-emerald-50/60 p-6 sm:p-8"
  aria-labelledby="job-apply-faq-heading"
>
  <h2 id="job-apply-faq-heading" class="text-xl font-bold text-gray-900 sm:text-2xl">
    {JOB_APPLY_FAQ_HEADING}
  </h2>
  <p class="mt-2 max-w-3xl text-sm leading-6 text-gray-600">{JOB_APPLY_FAQ_LEAD}</p>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {JOB_APPLY_FAQ_ITEMS.map((item, index) => (
      <li class="flex h-full flex-col rounded-2xl border border-indigo-100 bg-white p-5 shadow-sm">
        <span
          class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white"
          aria-hidden="true"
        >
          {index + 1}
        </span>
        <h3 class="text-base font-semibold leading-snug text-gray-900">{item.question}</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600">{item.answer}</p>
      </li>
    ))}
  </ul>
</section>
