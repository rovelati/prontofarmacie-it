---
import BrandWordmark from '@/components/BrandWordmark.astro';

const nav = [
  {
    href: '/farmacie-di-turno/',
    label: 'Turni',
    match: (p: string, u: URL) =>
      p.startsWith('/farmacie-di-turno') &&
      !u.searchParams.has('lat') &&
      !u.searchParams.has('near'),
  },
  {
    href: '/farmacie-di-turno/?near=1',
    label: 'Vicino a me',
    match: (p: string, u: URL) =>
      p.startsWith('/farmacie-di-turno') &&
      (u.searchParams.has('lat') || u.searchParams.has('lng') || u.searchParams.has('near')),
  },
  { href: '/listafarmacie/', label: 'Liste', match: (p: string) => p.startsWith('/listafarmacie') },
  { href: '/lavoro/', label: 'Lavoro', match: (p: string) => p.startsWith('/lavoro') && !p.startsWith('/lavoro/area-candidati') },
  { href: '/notizie-farmacie-e-salute/', label: 'Notizie', match: (p: string) => p.startsWith('/notizie-farmacie-e-salute') },
  { href: '/shop/elenco-dei-migliori-ecommerce-del-farmaco-trova-link-promo-sconti/', label: 'Shop', match: (p: string) => p.startsWith('/shop') || p.startsWith('/shops') },
];

const sideLinks = [
  { href: '/area-farmacia/', label: 'Per farmacie', match: (p: string) => p.startsWith('/area-farmacia') || p.startsWith('/pronto-farmacie-dalla-parte') },
  { href: '/lavoro/area-candidati/', label: 'Candidati', match: (p: string) => p.startsWith('/lavoro/area-candidati') },
];

const path = Astro.url.pathname;
const pageUrl = Astro.url;

function isActive(item: { match: (p: string, u?: URL) => boolean }): boolean {
  return item.match.length >= 2 ? item.match(path, pageUrl) : item.match(path);
}
---

<header class="border-b border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900">
  <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6 lg:flex lg:items-center lg:justify-between lg:gap-4 lg:py-4">
    <div class="flex items-center justify-between gap-3">
      <BrandWordmark />
      <details class="relative lg:hidden">
        <summary class="list-none rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-800 marker:hidden hover:bg-gray-50 dark:border-slate-600 dark:text-slate-100 dark:hover:bg-slate-800 [&::-webkit-details-marker]:hidden">
          Menu
        </summary>
        <nav class="absolute right-0 z-50 mt-3 grid w-[min(86vw,320px)] grid-cols-2 gap-2 rounded-2xl border border-gray-200 bg-white p-3 text-center text-sm font-medium text-gray-700 shadow-xl dark:border-slate-600 dark:bg-slate-900 dark:text-slate-200 dark:shadow-black/40">
          {nav.map((item) => {
            const active = isActive(item);
            return (
              <a
                href={item.href}
                class={`rounded-full px-3 py-2 transition ${
                  active
                    ? 'bg-emerald-50 font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300'
                    : 'hover:bg-gray-50 hover:text-emerald-700 dark:hover:bg-slate-800 dark:hover:text-emerald-300'
                }`}
              >
                {item.label}
              </a>
            );
          })}
          {sideLinks.map((item) => {
            const active = isActive(item);
            return (
              <a
                href={item.href}
                class={`col-span-2 rounded-full px-3 py-2 transition ${
                  active
                    ? 'bg-teal-50 font-semibold text-teal-800 dark:bg-teal-950 dark:text-teal-300'
                    : 'border border-dashed border-gray-200 hover:bg-gray-50 dark:border-slate-600 dark:hover:bg-slate-800'
                }`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </details>
    </div>
    <div class="hidden items-center gap-2 lg:flex">
      <nav class="flex justify-end gap-1 text-sm font-medium text-gray-700 dark:text-slate-200">
        {nav.map((item) => {
          const active = isActive(item);
          return (
            <a
              href={item.href}
              class={`rounded-full px-3 py-2 transition ${
                active
                  ? 'bg-emerald-50 font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300'
                  : 'hover:bg-gray-50 hover:text-emerald-700 dark:hover:bg-slate-800 dark:hover:text-emerald-300'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
      <div class="ml-2 flex gap-1 border-l border-gray-200 pl-3 text-sm font-semibold dark:border-slate-700">
        {sideLinks.map((item) => {
          const active = isActive(item);
          return (
            <a
              href={item.href}
              class={`rounded-full px-3 py-2 transition ${
                active
                  ? 'bg-teal-50 text-teal-800 dark:bg-teal-950 dark:text-teal-300'
                  : 'text-teal-700 hover:bg-teal-50 dark:text-teal-300 dark:hover:bg-teal-950'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</header>
