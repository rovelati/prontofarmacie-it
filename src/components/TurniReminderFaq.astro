---
import { TURNI_REMINDER_FAQ_HEADING, TURNI_REMINDER_FAQ_ITEMS, TURNI_REMINDER_FAQ_LEAD } from '@/lib/turniFaq';
---

<section
  class="mt-10 rounded-2xl border border-emerald-100 bg-emerald-50 p-6 dark:border-emerald-800 dark:bg-slate-900 sm:p-8"
  aria-labelledby="turni-reminder-faq-heading"
>
  <h2 id="turni-reminder-faq-heading" class="text-xl font-bold text-gray-900 dark:text-emerald-50 sm:text-2xl">
    {TURNI_REMINDER_FAQ_HEADING}
  </h2>
  <p class="mt-2 max-w-3xl text-sm leading-6 text-gray-600 dark:text-emerald-100/85">{TURNI_REMINDER_FAQ_LEAD}</p>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {TURNI_REMINDER_FAQ_ITEMS.map((item, index) => (
      <li class="flex h-full flex-col rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm dark:border-emerald-800 dark:bg-slate-950 dark:shadow-none">
        <span class="mb-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-emerald-600 text-sm font-bold text-white dark:bg-emerald-500 dark:text-emerald-950" aria-hidden="true">
          {index + 1}
        </span>
        <h3 class="text-base font-semibold leading-snug text-gray-900 dark:text-slate-50">{item.question}</h3>
        <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-slate-300">{item.answer}</p>
      </li>
    ))}
  </ul>
</section>
