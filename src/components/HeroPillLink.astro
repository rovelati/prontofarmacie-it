---
interface Props {
  href: string;
  variant?: 'solid' | 'outline';
}

const { href, variant = 'outline' } = Astro.props;
const classes =
  variant === 'solid'
    ? 'rounded-full bg-white/95 px-4 py-2 text-sm font-semibold text-gray-900 hover:bg-white sm:px-5 sm:py-2.5'
    : 'rounded-full border-2 border-white/90 px-4 py-2 text-sm font-semibold text-white hover:bg-white/10 sm:px-5 sm:py-2.5';
---

<a href={href} class={classes}>
  <slot />
</a>
