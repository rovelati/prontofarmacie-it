---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GeoNearMeButton from '@/components/GeoNearMeButton';
import JobReminderFaq from '@/components/JobReminderFaq.astro';
import JobsMapIsland from '@/components/JobsMapIsland';
import ScrollToJobResultsOnMount from '@/components/ScrollToJobResultsOnMount';
import { buildBreadcrumbJsonLd, buildFaqJsonLd } from '@/lib/seo';
import {
  NEAR_ME_EXTENDED_MAX_KM,
  NEAR_ME_PREFERRED_KM,
  mergeJobFaqForJsonLd,
} from '@/lib/jobFaq';
import { fetchJobsNearLocation, formatJobPostedLabel, jobDetailPath, roleCategoryFromSlug } from '@/lib/jobs';
import { siteUrl } from '@/lib/turni';

const base = siteUrl(import.meta.env);
const title = 'Lavoro in farmacia vicino a te | ProntoFarmacie';
const description = `Offerte di lavoro in farmacia vicino a te: prima entro ${NEAR_ME_PREFERRED_KM} km, poi estensione fino a ${NEAR_ME_EXTENDED_MAX_KM} km se serve.`;
const canonical = `${base}/lavoro-vicino-a-te/`;

const latParam = Astro.url.searchParams.get('lat');
const lngParam = Astro.url.searchParams.get('lng');
const roleParam = Astro.url.searchParams.get('role');
const lat = latParam != null ? Number.parseFloat(latParam) : Number.NaN;
const lng = lngParam != null ? Number.parseFloat(lngParam) : Number.NaN;
const hasGeo = Number.isFinite(lat) && Number.isFinite(lng);
const roleSlug = roleParam?.trim() || null;
const roleLabel = roleSlug && roleSlug !== 'tutte' ? roleCategoryFromSlug(roleSlug) || roleSlug : null;

let jobs: Awaited<ReturnType<typeof fetchJobsNearLocation>>['jobs'] = [];
let radiusKm = 0;
let extended = false;

if (hasGeo) {
  const result = await fetchJobsNearLocation(lat, lng, NEAR_ME_EXTENDED_MAX_KM, roleSlug);
  jobs = result.jobs;
  radiusKm = result.radiusKm;
  extended = result.extended;
}

const geoHeading = hasGeo
  ? jobs.length > 0
    ? extended
      ? `Offerte di lavoro entro ${radiusKm} km (oltre ${NEAR_ME_PREFERRED_KM} km)`
      : `Offerte di lavoro entro ${NEAR_ME_PREFERRED_KM} km`
    : `Nessuna offerta entro ${NEAR_ME_EXTENDED_MAX_KM} km`
  : 'Lavoro in farmacia vicino a te';

const geoDescription = hasGeo
  ? jobs.length > 0
    ? extended
      ? `Trovate ${jobs.length} offerte entro ${radiusKm} km (ricerca estesa oltre ${NEAR_ME_PREFERRED_KM} km, massimo ${NEAR_ME_EXTENDED_MAX_KM} km)${roleLabel ? ` per ${roleLabel}` : ''}.`
      : `Trovate ${jobs.length} offerte entro ${NEAR_ME_PREFERRED_KM} km dalla tua posizione${roleLabel ? ` per ${roleLabel}` : ''}.`
    : `Al momento non risultano offerte attive entro ${NEAR_ME_EXTENDED_MAX_KM} km${roleLabel ? ` per ${roleLabel}` : ''}. Prova ad allargare la ricerca o consulta tutta Italia.`
  : description;

const mapPoints = jobs
  .filter((job) => job.pharmacy?.latitude != null && job.pharmacy?.longitude != null)
  .map((job) => ({
    lat: Number(job.pharmacy!.latitude),
    lng: Number(job.pharmacy!.longitude),
    id: job.id,
    title: job.title_seo || job.title,
    city: job.pharmacy?.city || '',
    pharmacyName: job.pharmacy?.name || '',
    detailLink: jobDetailPath(job),
  }));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: hasGeo ? `${canonical}?lat=${lat}&lng=${lng}` : canonical,
    name: title,
    description: geoDescription,
    inLanguage: 'it-IT',
  },
  buildBreadcrumbJsonLd([
    { name: 'Home', url: `${base}/` },
    { name: 'Lavoro', url: `${base}/lavoro/` },
    { name: 'Vicino a te', url: canonical },
  ]),
  buildFaqJsonLd(mergeJobFaqForJsonLd()),
  ...(jobs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'ItemList',
          name: geoHeading,
          itemListElement: jobs.map((job, idx) => ({
            '@type': 'ListItem',
            position: idx + 1,
            name: job.title_seo || job.title,
            url: `${base}${jobDetailPath(job)}`,
          })),
        },
      ]
    : []),
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <section class="relative overflow-hidden bg-gradient-to-br from-indigo-700 via-violet-600 to-emerald-600 py-14 text-white sm:py-16">
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-white/80">Lavoro in farmacia</p>
      <h1 class="mt-4 text-3xl font-extrabold sm:text-4xl">Lavoro in farmacia vicino a te</h1>
      <p class="mt-4 max-w-2xl text-white/90">
        {hasGeo
          ? geoDescription
          : `Attiva la geolocalizzazione: cerchiamo prima entro ${NEAR_ME_PREFERRED_KM} km, poi fino a ${NEAR_ME_EXTENDED_MAX_KM} km se servono più risultati.`}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <GeoNearMeButton
          client:load
          targetPath="/lavoro-vicino-a-te/"
          hash="job-results"
          buttonLabel="Cerca lavori vicino a me"
          loadingLabel="Sto localizzando..."
        />
        <a href="/lavoro/" class="inline-flex items-center rounded-full border-2 border-white/90 bg-white/95 px-6 py-3 text-sm font-semibold text-gray-900 hover:bg-white">
          Tutte le offerte
        </a>
        <a href="/lavoro/tutta-italia/tutte/" class="inline-flex items-center rounded-full border-2 border-white/70 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">
          Tutta Italia
        </a>
      </div>
      {roleLabel && hasGeo && (
        <p class="mt-4 text-sm text-white/85">Filtro ruolo attivo: <strong>{roleLabel}</strong></p>
      )}
    </div>
  </section>

  {hasGeo ? (
    <>
      <ScrollToJobResultsOnMount client:load />
      <div id="job-results" class="scroll-mt-6 mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">{geoHeading}</h2>
          <p class="mt-2 text-sm text-gray-600">{geoDescription}</p>
        </div>

        {hasGeo && (
          <div class="relative mb-10 h-[400px] overflow-hidden rounded-2xl border border-gray-200 shadow-lg md:h-[480px]">
            <JobsMapIsland client:only="react" points={mapPoints} userLocation={{ lat, lng }} showLegend />
          </div>
        )}

        {jobs.length > 0 ? (
          <ul class="grid gap-4 sm:grid-cols-2">
            {jobs.map((job) => {
              const postedLabel = formatJobPostedLabel(job.date_posted);
              return (
              <li>
                <a href={jobDetailPath(job)} class="block h-full rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:border-indigo-300 hover:bg-indigo-50/30">
                  <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">{job.category || 'Offerta lavoro'}</p>
                  <h3 class="mt-2 text-lg font-semibold text-gray-900">{job.title_seo || job.title}</h3>
                  <p class="mt-2 text-sm font-semibold text-indigo-700">
                    Circa {job.distanceKm.toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} km da te
                  </p>
                  <p class="mt-1 text-sm text-gray-500">
                    {[job.pharmacy?.name, job.pharmacy?.city, job.contract_type].filter(Boolean).join(' · ')}
                  </p>
                  {postedLabel && (
                    <p class="mt-2">
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">{postedLabel}</span>
                    </p>
                  )}
                  {job.excerpt && <p class="mt-3 text-sm text-gray-600 line-clamp-2">{job.excerpt.replace(/<[^>]+>/g, '')}</p>}
                </a>
              </li>
              );
            })}
          </ul>
        ) : (
          <div class="rounded-2xl border border-gray-200 bg-white p-8 text-center shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">Nessuna offerta in zona al momento</h2>
            <p class="mt-2 text-sm text-gray-600">Prova la ricerca nazionale o attiva il radar per ricevere nuovi annunci.</p>
            <div class="mt-4 flex flex-wrap justify-center gap-2">
              <a href="/lavoro/tutta-italia/tutte/" class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">Tutta Italia</a>
              <a href="/lavoro/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 hover:border-indigo-300">Pagina lavoro</a>
            </div>
          </div>
        )}

        <JobReminderFaq />
      </div>
    </>
  ) : (
    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-lg font-semibold text-gray-900">Come funziona</h2>
        <ol class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            ['1. Geolocalizzazione', 'Consenti l’accesso alla posizione dal browser.'],
            ['2. Ricerca automatica', `Prima entro ${NEAR_ME_PREFERRED_KM} km; se non basta, estensione fino a ${NEAR_ME_EXTENDED_MAX_KM} km.`],
            ['3. Distanza e mappa', 'Vedi km da te e sedi delle farmacie che assumono.'],
            ['4. Candidati con cura', 'Leggi l’annuncio e segui i consigli in fondo pagina.'],
          ].map(([t, d]) => (
            <li class="rounded-xl border bg-gray-50 p-4">
              <p class="text-sm font-semibold text-gray-900">{t}</p>
              <p class="mt-1 text-xs text-gray-600">{d}</p>
            </li>
          ))}
        </ol>
      </div>
      <JobReminderFaq />
    </section>
  )}
</BaseLayout>
