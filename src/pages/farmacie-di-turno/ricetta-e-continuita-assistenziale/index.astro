---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GuardiaMedicaSection from '@/components/GuardiaMedicaSection.astro';
import {
  buildGuardiaMedicaFaqItems,
  buildGuardiaMedicaPageDescription,
  guardiaMedicaPageUrl,
} from '@/lib/guardiaMedica';
import { buildBreadcrumbJsonLd, buildFaqJsonLd, buildMedicalWebPageJsonLd } from '@/lib/seo';
import { siteUrl } from '@/lib/turni';
import { buildTurniSeoTitle } from '@/lib/turniProvinceSeo';

const base = siteUrl(import.meta.env);
const canonical = guardiaMedicaPageUrl(import.meta.env);
const title = buildTurniSeoTitle('Ricetta e Continuità Assistenziale');
const description = buildGuardiaMedicaPageDescription();

const jsonLd = [
  buildMedicalWebPageJsonLd({ url: canonical, name: title, description }),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: `${base}/` },
    { name: 'Farmacie di turno', url: `${base}/farmacie-di-turno/` },
    { name: 'Ricetta e Continuità Assistenziale', url: canonical },
  ]),
  buildFaqJsonLd(buildGuardiaMedicaFaqItems({})),
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="text-sm text-gray-500">
      <a href="/farmacie-di-turno/" class="font-medium text-emerald-700 hover:underline">Farmacie di turno</a>
      <span aria-hidden="true"> / </span>
      <span class="text-gray-700">Ricetta e Continuità Assistenziale</span>
    </nav>
    <h1 class="mt-4 text-3xl font-bold text-gray-900 sm:text-4xl">
      Ricetta medica e Continuità Assistenziale
    </h1>
    <p class="mt-3 max-w-3xl text-gray-600">
      Guida per chi trova una farmacia di turno aperta ma ha bisogno di un farmaco con prescrizione.
      Numeri utili, 116117 e riferimenti per Regione o comune.
    </p>
    <p class="mt-4 text-sm text-gray-600">
      Cerca per città dalla
      {' '}
      <a href="/farmacie-di-turno/" class="font-semibold text-emerald-700 hover:underline">pagina farmacie di turno</a>
      {' '}
      e apri la guida localizzata dal link in fondo all’elenco.
    </p>

    <GuardiaMedicaSection />
  </div>
</BaseLayout>
