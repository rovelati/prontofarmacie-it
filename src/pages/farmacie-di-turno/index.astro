---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPillLink from '@/components/HeroPillLink.astro';
import HeroSearchForm from '@/components/HeroSearchForm.astro';
import SectionHero from '@/components/SectionHero.astro';
import TurniReminderFaq from '@/components/TurniReminderFaq.astro';
import TurniListing from '@/components/TurniListing.astro';
import GuardiaMedicaTeaser from '@/components/GuardiaMedicaTeaser.astro';
import GeoNearMeButton from '@/components/GeoNearMeButton';
import ScrollToTurniMapOnMount from '@/components/ScrollToTurniMapOnMount';
import { buildBreadcrumbJsonLd, buildFaqJsonLd, buildMedicalWebPageJsonLd } from '@/lib/seo';
import { mergeTurniFaqForJsonLd } from '@/lib/turniFaq';
import { siteUrl } from '@/lib/turni';
import { buildTurniSeoTitle, buildTurniSeoTitleVicino } from '@/lib/turniProvinceSeo';
import { buildLocationTree } from '@/data/locationTree';
import {
  fetchOpenPharmaciesNearLocation,
  latestUpdatedAt,
  NEAR_ME_EXTENDED_MAX_KM,
  NEAR_ME_PREFERRED_KM,
  type PharmacyRow,
} from '@/lib/turniData';

const base = siteUrl(import.meta.env);
const LOCATION_TREE = buildLocationTree(base);
const canonical = `${base}/farmacie-di-turno/`;

const latParam = Astro.url.searchParams.get('lat');
const lngParam = Astro.url.searchParams.get('lng');
const nearParam = Astro.url.searchParams.get('near');
const lat = latParam != null ? Number.parseFloat(latParam) : Number.NaN;
const lng = lngParam != null ? Number.parseFloat(lngParam) : Number.NaN;
const hasGeo = Number.isFinite(lat) && Number.isFinite(lng);
const autoStartNear = !hasGeo && (nearParam === '1' || nearParam === 'true');

let rows: (PharmacyRow & { distanceKm?: number })[] = [];
let radiusKm = 0;
let extended = false;

if (hasGeo) {
  const result = await fetchOpenPharmaciesNearLocation(lat, lng, NEAR_ME_EXTENDED_MAX_KM);
  rows = result.rows;
  radiusKm = result.radiusKm;
  extended = result.extended;
}

const updatedAt = latestUpdatedAt(rows);
const title = hasGeo ? buildTurniSeoTitleVicino() : buildTurniSeoTitle();
const description = hasGeo
  ? `Trova farmacie di turno aperte: prima entro ${NEAR_ME_PREFERRED_KM} km, poi estensione fino a ${NEAR_ME_EXTENDED_MAX_KM} km se serve.`
  : 'Trova farmacie di turno aperte ora: inserisci città o provincia, oppure usa la geolocalizzazione.';

const geoHeading = hasGeo
  ? rows.length > 0
    ? extended
      ? `Farmacie di turno aperte entro ${radiusKm} km (oltre ${NEAR_ME_PREFERRED_KM} km)`
      : `Farmacie di turno aperte entro ${NEAR_ME_PREFERRED_KM} km`
    : `Nessuna farmacia aperta entro ${NEAR_ME_EXTENDED_MAX_KM} km`
  : '';

const geoDescription = hasGeo
  ? rows.length > 0
    ? extended
      ? `Trovate ${rows.length} farmacie aperte ora entro ${radiusKm} km (ricerca estesa oltre ${NEAR_ME_PREFERRED_KM} km, massimo ${NEAR_ME_EXTENDED_MAX_KM} km).`
      : `Trovate ${rows.length} farmacie aperte ora entro ${NEAR_ME_PREFERRED_KM} km dalla tua posizione.`
    : `Al momento non risultano farmacie aperte entro ${NEAR_ME_EXTENDED_MAX_KM} km dalla tua posizione.`
  : description;

const faqItems = [
  {
    question: 'Come trovo una farmacia di turno aperta ora?',
    answer:
      'Inserisci città o provincia nel campo di ricerca, oppure tocca «Vicino a me» per le farmacie più vicine.',
  },
  {
    question: 'Conviene telefonare prima di andare?',
    answer: 'Sì: i turni possono cambiare. Una telefonata evita viaggi a vuoto.',
  },
];

const allLinks = LOCATION_TREE.flatMap((section) =>
  section.nodes.flatMap((node) => [
    { name: node.label, url: node.href },
    ...(node.children?.map((c) => ({ name: c.label, url: c.href })) ?? []),
  ]),
);

const jsonLd = hasGeo
  ? [
      buildMedicalWebPageJsonLd({
        url: `${canonical}?lat=${lat}&lng=${lng}`,
        name: title,
        description: geoDescription,
      }),
      buildBreadcrumbJsonLd([
        { name: 'Home', url: `${base}/` },
        { name: 'Farmacie di turno', url: canonical },
        { name: 'Vicino a te', url: `${canonical}?lat=${lat}&lng=${lng}` },
      ]),
      buildFaqJsonLd(mergeTurniFaqForJsonLd(faqItems)),
    ]
  : [
      buildMedicalWebPageJsonLd({ url: canonical, name: title, description }),
      buildBreadcrumbJsonLd([
        { name: 'Home', url: `${base}/` },
        { name: 'Farmacie di turno', url: canonical },
      ]),
      buildFaqJsonLd(mergeTurniFaqForJsonLd(faqItems)),
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Località con farmacie di turno',
        itemListElement: allLinks.map((row, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: row.name,
          url: row.url,
        })),
      },
    ];

const nearMeButtonClass =
  'rounded-full bg-white/95 px-4 py-2 text-sm font-semibold text-gray-900 hover:bg-white sm:px-5 sm:py-2.5 disabled:opacity-70';
---

<BaseLayout title={title} description={hasGeo ? geoDescription : description} canonical={canonical} jsonLd={jsonLd}>
  <SectionHero
    eyebrow="Farmacie di turno"
    title={hasGeo ? 'Farmacia di turno vicino a te' : 'Trova una farmacia di turno aperta ora'}
    description={
      hasGeo
        ? geoDescription
        : 'Inserisci la località oppure usa il GPS per trovare la farmacia più vicina.'
    }
  >
    {!hasGeo && (
      <HeroSearchForm
        action="/farmacie-di-turno/cerca"
        placeholder="Es. Milano, provincia di Como, Mantova…"
        buttonLabel="Cerca località"
        required
      />
    )}
    <div slot="footer" class="flex flex-wrap gap-2 sm:gap-3">
      <GeoNearMeButton
        client:load
        targetPath="/farmacie-di-turno/"
        buttonLabel="Vicino a me"
        loadingLabel="Sto localizzando…"
        autoStart={autoStartNear}
        buttonClassName={nearMeButtonClass}
        errorClassName="mt-2 w-full text-sm text-amber-100"
      />
      {!hasGeo && (
        <>
          <HeroPillLink href="/listafarmacie/italia/">Lista farmacie</HeroPillLink>
          <HeroPillLink href="/">Home</HeroPillLink>
        </>
      )}
      {hasGeo && <HeroPillLink href="/farmacie-di-turno/">Cerca per località</HeroPillLink>}
    </div>
  </SectionHero>

  {hasGeo ? (
    <>
      <ScrollToTurniMapOnMount client:load />
      <TurniListing
        scope="geo"
        title={title}
        description={geoDescription}
        heading={geoHeading}
        subheading="dalla tua posizione"
        rows={rows}
        updatedAt={updatedAt}
        searchCenter={{ lat, lng }}
        distanceBySlug={Object.fromEntries(rows.map((r) => [r.prontofarmacie_slug || '', r.distanceKm ?? 0]))}
      />
      <div class="page-section">
        <TurniReminderFaq />
      </div>
    </>
  ) : (
    <div class="page-section">
      <section class="mb-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8" aria-labelledby="how-heading">
        <h2 id="how-heading" class="text-lg font-semibold text-gray-900">Come funziona «Vicino a me»</h2>
        <ol class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {[
            ['1. Geolocalizzazione', 'Consenti l’accesso alla posizione dal browser.'],
            [
              '2. Ricerca automatica',
              `Prima entro ${NEAR_ME_PREFERRED_KM} km; se non basta, estensione fino a ${NEAR_ME_EXTENDED_MAX_KM} km.`,
            ],
            ['3. Mappa e contatti', 'Telefono, orari e indicazioni stradali.'],
            ['4. Chiama e parti', 'Conferma al telefono prima del viaggio.'],
          ].map(([t, d]) => (
            <li class="rounded-xl border bg-gray-50 p-4">
              <p class="text-sm font-semibold text-gray-900">{t}</p>
              <p class="mt-1 text-xs text-gray-600">{d}</p>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="tree-heading">
        <h2 id="tree-heading" class="section-heading">Località più cercate</h2>
        <p class="section-lead">Link diretti alle pagine con farmacie aperte ora, mappa e contatti.</p>
        <div class="mt-6 space-y-8">
          {LOCATION_TREE.map((section) => (
            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
              <h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-700">{section.title}</h3>
              {section.layout === 'grid' ? (
                <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
                  {section.nodes.map((node) => (
                    <div class="rounded-xl border border-emerald-100 bg-emerald-50/40 p-4">
                      <a
                        href={node.href}
                        class="flex items-center gap-2 rounded-lg px-2 py-1.5 text-sm font-semibold text-gray-900 hover:bg-white hover:text-emerald-800"
                      >
                        <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></span>
                        {node.label}
                      </a>
                      {node.children && node.children.length > 0 && (
                        <ul class="mt-2 ml-4 space-y-0.5 border-l-2 border-emerald-200/80 pl-3">
                          {node.children.map((child) => (
                            <li>
                              <a
                                href={child.href}
                                class="block rounded-md px-2 py-1 text-sm text-gray-700 hover:bg-white hover:text-emerald-800"
                              >
                                {child.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="mt-3 space-y-1">
                  {section.nodes.map((node) => (
                    <li>
                      <a
                        href={node.href}
                        class="flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium text-gray-800 hover:bg-emerald-50 hover:text-emerald-800"
                      >
                        <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                        {node.label}
                      </a>
                      {node.children && node.children.length > 0 && (
                        <ul class="ml-4 space-y-1 border-l-2 border-emerald-100 pl-4">
                          {node.children.map((child) => (
                            <li>
                              <a
                                href={child.href}
                                class="block rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-emerald-50 hover:text-emerald-800"
                              >
                                {child.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>

      <div class="mt-10">
        <GuardiaMedicaTeaser />
      </div>
      <TurniReminderFaq />
    </div>
  )}
</BaseLayout>
