---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OfferteDiOggiPanel from '@/components/shop/OfferteDiOggiPanel.jsx';
import { fetchShopOfferCategoriesForDate, fetchShopOffersForDate, resolveShopOfferDate } from '@/lib/shop';
import { siteUrl } from '@/lib/turni';

const { categorySlug } = Astro.params;
if (!categorySlug) return Astro.redirect('/shops/offerte-di-oggi/', 302);

const names: Record<string, string> = {
  integratori: 'Integratori',
  dimagranti: 'Dimagranti e Controllo Peso',
  vitamine: 'Vitamine e Minerali',
  dermatologici: 'Dermatologici e Cura Pelle',
  probiotici: 'Probiotici e Fermenti',
  omeopatici: 'Omeopatici e Fitoterapici',
  igiene: 'Igiene e Cura Personale',
  altro: 'Altro',
};

const categoryName = names[categorySlug] || categorySlug;
const title = `Offerte di Oggi - ${categoryName} | ProntoFarmacie`;
const description = `Confronta le migliori offerte ${categoryName.toLowerCase()} oggi sugli e-commerce del farmaco.`;
const canonical = `${siteUrl(import.meta.env)}/shops/offerte-di-oggi/${categorySlug}/`;
const offerDate = await resolveShopOfferDate();
const [initialOffers, initialCategories] = await Promise.all([
  fetchShopOffersForDate(categorySlug, offerDate),
  fetchShopOfferCategoriesForDate(offerDate),
]);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <OfferteDiOggiPanel
    categorySlug={categorySlug}
    initialOffers={initialOffers}
    initialCategories={initialCategories}
    initialOfferDate={offerDate}
    client:load
  />
</BaseLayout>
