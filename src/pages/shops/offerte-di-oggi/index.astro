---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OfferteDiOggiPanel from '@/components/shop/OfferteDiOggiPanel.jsx';
import { fetchShopOfferCategoriesForDate, fetchShopOffersForDate, resolveShopOfferDate } from '@/lib/shop';
import { siteUrl } from '@/lib/turni';

const title = 'Offerte di Oggi - Comparatore E-commerce Farmacia | ProntoFarmacie';
const description =
  'Confronta le offerte del giorno degli e-commerce farmaceutici. Sconti aggiornati quotidianamente.';
const canonical = `${siteUrl(import.meta.env)}/shops/offerte-di-oggi/`;
const offerDate = await resolveShopOfferDate();
const [initialOffers, initialCategories] = await Promise.all([
  fetchShopOffersForDate(undefined, offerDate),
  fetchShopOfferCategoriesForDate(offerDate),
]);
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <OfferteDiOggiPanel
    initialOffers={initialOffers}
    initialCategories={initialCategories}
    initialOfferDate={offerDate}
    client:load
  />
</BaseLayout>
