---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHero from '@/components/SectionHero.astro';
import JobReminderFaq from '@/components/JobReminderFaq.astro';
import { buildBreadcrumbJsonLd, buildFaqJsonLd } from '@/lib/seo';
import { buildCityRoleJobFaq, mergeJobFaqForJsonLd } from '@/lib/jobFaq';
import {
  buildLavoroSeoDescription,
  buildLavoroSeoTitle,
  fetchJobListings,
  formatCityLabel,
  formatJobPostedLabel,
  formatJobRoleSeoLabel,
  shouldIndexJobListingPage,
  jobDetailPath,
  jobDisplayCity,
  jobHasMapCoordsInCity,
  jobPharmacyCityMatches,
  jobPharmacyDetailHref,
} from '@/lib/jobs';
import { fetchAdjacentZoneJobs } from '@/lib/jobAdjacentZones';
import { PROVINCES_BY_REGION } from '@/lib/locationUtils';
import { siteUrl } from '@/lib/turni';
import MarketplaceSignupCta from '@/components/marketplace/MarketplaceSignupCta.astro';
import JobsMapIsland from '@/components/JobsMapIsland';

const { city, role } = Astro.params;
if (!city || !role) return Astro.redirect('/lavoro/', 302);

const effectiveCity = city === 'cerca' ? 'tutta-italia' : city;
const isLegacySearchUrl = city === 'cerca';
const [jobs, adjacent] = await Promise.all([
  fetchJobListings(effectiveCity, role),
  effectiveCity === 'tutta-italia' ? Promise.resolve(null) : fetchAdjacentZoneJobs(effectiveCity, role),
]);
const adjacentJobs = adjacent
  ? adjacent.zones.flatMap((z) => z.jobs.map((job) => ({ job, zoneLabel: z.label, zoneHref: z.href })))
  : [];
const adjacentSeen = new Set<string>();
const adjacentUnique = adjacentJobs.filter(({ job }) => {
  if (adjacentSeen.has(job.id)) return false;
  adjacentSeen.add(job.id);
  return true;
}).slice(0, 8);

function regionFromProvinceCode(code?: string | null): string | null {
  if (!code) return null;
  const needle = code.toUpperCase();
  for (const [region, codes] of Object.entries(PROVINCES_BY_REGION)) {
    if (codes.includes(needle)) return region;
  }
  return null;
}

const regionLabel =
  effectiveCity === 'tutta-italia'
    ? null
    : regionFromProvinceCode(
        jobs.find((j) => jobPharmacyCityMatches(j, effectiveCity) && j.pharmacy?.province)?.pharmacy
          ?.province,
      ) ||
      regionFromProvinceCode(jobs.find((j) => j.pharmacy?.province)?.pharmacy?.province);

const title = buildLavoroSeoTitle(effectiveCity, role, { regionLabel });
const description = buildLavoroSeoDescription(effectiveCity, role, jobs.length, { regionLabel });
const base = siteUrl(import.meta.env);
const locationLabel = formatCityLabel(effectiveCity);
const roleLabel = role === 'tutte' ? 'Tutti i ruoli' : formatJobRoleSeoLabel(role);
const locationPhrase = effectiveCity === 'tutta-italia' ? 'in tutta Italia' : `a ${locationLabel}`;
const canonical = `${base}/lavoro/${effectiveCity}/${role}/`;
const pageTitle = isLegacySearchUrl
  ? 'Risultati ricerca lavoro in farmacia'
  : title.replace(/\s*\|\s*ProntoFarmacie\s*$/i, '');
const noindexPage = !shouldIndexJobListingPage(role, jobs.length);
const searchedSummary = [
  `Offerte di Lavoro`,
  `Località: ${effectiveCity === 'tutta-italia' ? 'Tutta Italia' : locationLabel}`,
  `Ruolo: ${roleLabel}`,
].join(' · ');
const localFaqItems = buildCityRoleJobFaq({
  cityLabel: locationLabel,
  roleLabel,
  jobCount: jobs.length,
  locationPhrase,
});
/** Mappa: solo sedi nella città cercata (niente HQ agenzie fuori zona). */
const geoJobs = jobs.filter((job) => jobHasMapCoordsInCity(job, effectiveCity));
const addressJobs = jobs
  .filter(
    (job) =>
      jobPharmacyCityMatches(job, effectiveCity) && (job.pharmacy?.address || job.pharmacy?.city),
  )
  .slice(0, 8);
const mapPoints = geoJobs.map((job) => ({
  lat: Number(job.pharmacy?.latitude),
  lng: Number(job.pharmacy?.longitude),
  id: String(job.id),
  title: job.title_seo || job.title,
  city: job.pharmacy?.city || locationLabel,
  pharmacyName: job.pharmacy?.name || '',
  detailLink: jobDetailPath(job),
}));
const mapOpenUrl =
  mapPoints.length > 0
    ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${mapPoints[0].lat},${mapPoints[0].lng}`)}`
    : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
        effectiveCity === 'tutta-italia' ? 'farmacie Italia' : `farmacie ${locationLabel}`,
      )}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: canonical,
    name: title,
    description,
    inLanguage: 'it-IT',
  },
  buildBreadcrumbJsonLd([
    { name: 'Home', url: `${base}/` },
    { name: 'Lavoro', url: `${base}/lavoro/` },
    { name: isLegacySearchUrl ? 'Ricerca' : locationLabel, url: canonical },
  ]),
  buildFaqJsonLd(mergeJobFaqForJsonLd(localFaqItems)),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: pageTitle,
    itemListElement: jobs.map((job, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: job.title_seo || job.title,
      url: `${base}${jobDetailPath(job)}`,
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} noindex={noindexPage}>
  <SectionHero
    eyebrow="Lavoro in farmacia"
    title={pageTitle}
    description={`${jobs.length} offerte trovate. Località: ${effectiveCity === 'tutta-italia' ? 'Tutta Italia' : locationLabel} · Ruolo: ${roleLabel}.`}
  />

  <div class="page-section">
    <section>
      <nav class="mb-6 text-sm text-gray-500">
        <a href="/" class="hover:text-emerald-700">Home</a> /
        <a href="/lavoro/" class="hover:text-emerald-700">Lavoro</a> /
        <span>{isLegacySearchUrl ? 'Ricerca' : locationLabel}</span>
      </nav>

      <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50/60 p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Cosa hai cercato</p>
        <h2 class="mt-2 text-xl font-bold text-gray-900">{searchedSummary}</h2>
        <p class="mt-2 text-sm text-gray-700">
          I risultati sono ordinati per pubblicazione recente. La mappa mostra solo le sedi nella zona cercata (non le sedi legali di agenzie fuori città).
        </p>
      </div>

      {jobs.length > 0 ? (
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
          <ul class="flex flex-col gap-5">
            {jobs.map((job) => {
              const inZone = jobHasMapCoordsInCity(job, effectiveCity);
              const lat = inZone && job.pharmacy?.latitude != null ? Number(job.pharmacy.latitude) : null;
              const lng = inZone && job.pharmacy?.longitude != null ? Number(job.pharmacy.longitude) : null;
              const hasCoords = lat != null && lng != null && Number.isFinite(lat) && Number.isFinite(lng);
              const displayCity = jobDisplayCity(job, effectiveCity);
              const agencyCity =
                !jobPharmacyCityMatches(job, effectiveCity) && job.pharmacy?.city?.trim()
                  ? job.pharmacy.city.trim()
                  : null;
              const postedLabel = formatJobPostedLabel(job.date_posted);
              const placeQuery = hasCoords
                ? `${lat},${lng}`
                : jobPharmacyCityMatches(job, effectiveCity)
                  ? [job.pharmacy?.name, job.pharmacy?.address, job.pharmacy?.city, job.pharmacy?.province]
                      .filter(Boolean)
                      .join(', ')
                  : displayCity
                    ? `${displayCity}, Italia`
                    : '';
              const pharmacyHref = jobPharmacyDetailHref(job);
              const placeMapUrl =
                !pharmacyHref && hasCoords
                  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${lat},${lng}`)}`
                  : !pharmacyHref && jobPharmacyCityMatches(job, effectiveCity) && placeQuery
                    ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(placeQuery)}`
                    : '';
              const mapIndex = hasCoords
                ? geoJobs.findIndex((g) => String(g.id) === String(job.id)) + 1
                : 0;
              return (
                <li class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
                  <a href={jobDetailPath(job)} class="block p-5 hover:border-emerald-300 hover:bg-emerald-50/40">
                    <div class="flex flex-wrap items-center gap-2">
                      {mapIndex > 0 && (
                        <span class="inline-flex h-6 min-w-6 items-center justify-center rounded-full bg-indigo-600 px-1.5 text-xs font-bold text-white">
                          {mapIndex}
                        </span>
                      )}
                      <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">{job.category || 'Offerta lavoro'}</p>
                    </div>
                    <h2 class="mt-2 text-lg font-semibold text-gray-900">{job.title_seo || job.title}</h2>
                    <p class="mt-2 text-sm text-gray-500">
                      {[job.pharmacy?.name, displayCity, job.contract_type].filter(Boolean).join(' · ')}
                      {agencyCity ? ` · Sede offerente: ${agencyCity}` : ''}
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {postedLabel && <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">{postedLabel}</span>}
                      {displayCity && <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">{displayCity}</span>}
                      {job.contract_type && <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">{job.contract_type}</span>}
                    </div>
                    {job.excerpt && <p class="mt-3 text-sm text-gray-600 line-clamp-2">{job.excerpt.replace(/<[^>]+>/g, '')}</p>}
                  </a>
                  {(pharmacyHref || placeMapUrl) && (
                    <div class="border-t border-gray-100 px-5 py-3">
                      {pharmacyHref ? (
                        <a href={pharmacyHref} class="text-sm font-semibold text-emerald-700 hover:underline">
                          {pharmacyHref.startsWith('/listafarmacie/')
                            ? 'Farmacie in zona su ProntoFarmacie'
                            : 'Scheda farmacia su ProntoFarmacie'}
                        </a>
                      ) : (
                        <a href={placeMapUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-emerald-700 hover:underline">
                          Apri posizione su Google Maps
                        </a>
                      )}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>

          <aside class="lg:sticky lg:top-6 lg:self-start">
            <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
              <div class="border-b border-gray-100 p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Mappa offerte</p>
                <h2 class="mt-2 text-lg font-semibold text-gray-900">{locationPhrase}</h2>
                <p class="mt-2 text-sm text-gray-600">
                  {mapPoints.length > 0
                    ? `${mapPoints.length} sedi con coordinate. I numeri sulla mappa corrispondono all’elenco a sinistra.`
                    : 'Coordinate non disponibili per queste offerte.'}
                </p>
              </div>
              {mapPoints.length > 0 ? (
                <div class="h-[420px] w-full">
                  <JobsMapIsland client:only="react" points={mapPoints} showLegend />
                </div>
              ) : (
                <div class="flex h-[220px] items-center justify-center bg-slate-50 px-6 text-center text-sm text-gray-500">
                  Nessuna sede geolocalizzata in questo elenco.
                </div>
              )}
              <div class="space-y-3 border-t border-gray-100 p-5">
                <a href={mapOpenUrl} target="_blank" rel="noopener noreferrer" class="block rounded-xl bg-emerald-600 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-emerald-700">
                  Indicazioni verso la prima sede
                </a>
                {addressJobs.length > 0 && (
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">Sedi in elenco</p>
                    <ul class="mt-2 space-y-2 text-sm text-gray-700">
                      {addressJobs.slice(0, 5).map((job) => (
                        <li class="border-l-2 border-emerald-100 pl-3">
                          <span class="font-medium text-gray-900">{job.pharmacy?.name || job.title}</span>
                          <br />
                          {[job.pharmacy?.address, job.pharmacy?.city].filter(Boolean).join(' · ')}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </aside>
        </div>
      ) : (
        <div class="section-card">
          <h2 class="text-lg font-semibold text-gray-900">Nessuna offerta per questi filtri</h2>
          <p class="mt-2 text-sm text-gray-600">
            {adjacent?.config.countryNote ||
              'Prova la ricerca nazionale oppure torna alla pagina principale delle offerte di lavoro.'}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href="/lavoro/tutta-italia/tutte/" class="rounded-full bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-100">Tutta Italia</a>
            <a href="/lavoro/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 hover:border-emerald-300">Pagina lavoro</a>
            <a href="/lavoro-vicino-a-te/" class="rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-gray-700 hover:border-emerald-300">Vicino a me</a>
          </div>
        </div>
      )}

      {adjacent && (
        <section class="mt-8">
          <div class="mb-4">
            <h2 class="section-heading">Zone limitrofe in Italia</h2>
            {jobs.length > 0 && (
              <p class="mt-2 text-sm text-gray-600">{adjacent.config.countryNote}</p>
            )}
          </div>

          <div class="mb-5 flex flex-wrap gap-2">
            {adjacent.config.zones.map((zone) => {
              const found = adjacent.zones.find((z) => z.slug === zone.slug);
              return (
                <a
                  href={`/lavoro/${zone.slug}/${role}/`}
                  class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-800 hover:bg-emerald-100"
                >
                  {zone.label}
                  {found ? ` (${found.count})` : ''}
                </a>
              );
            })}
          </div>

          {adjacentUnique.length > 0 ? (
            <ul class="grid gap-4 sm:grid-cols-2">
              {adjacentUnique.map(({ job, zoneLabel, zoneHref }) => (
                <li class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
                  <a href={jobDetailPath(job)} class="block hover:border-emerald-300">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-full bg-sky-50 px-2.5 py-0.5 text-xs font-semibold text-sky-800">
                        {zoneLabel}
                      </span>
                      {job.category && (
                        <span class="text-xs font-semibold uppercase tracking-wide text-emerald-600">
                          {job.category}
                        </span>
                      )}
                    </div>
                    <p class="mt-2 font-semibold text-gray-900">{job.title_seo || job.title}</p>
                    <p class="mt-1 text-sm text-gray-500">
                      {[job.pharmacy?.name, job.pharmacy?.city, job.contract_type].filter(Boolean).join(' · ')}
                    </p>
                    <p class="mt-3 text-sm font-semibold text-emerald-700">Vedi offerta →</p>
                  </a>
                  <a
                    href={zoneHref}
                    class="mt-2 inline-block text-xs font-medium text-gray-500 hover:text-emerald-700 hover:underline"
                  >
                    Tutte le offerte a {zoneLabel} →
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-gray-600">
              Al momento non risultano annunci attivi nelle zone limitrofe. Prova{' '}
              <a href="/lavoro/tutta-italia/tutte/" class="font-semibold text-emerald-700 hover:underline">Tutta Italia</a>
              {' '}o{' '}
              <a href="/lavoro-vicino-a-te/" class="font-semibold text-emerald-700 hover:underline">Vicino a me</a>.
            </p>
          )}
        </section>
      )}
    </section>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <MarketplaceSignupCta
        audience="job_seeker"
        title="Salva un alert su questa ricerca"
        lead="Ricevi mail solo quando escono offerte nella zona e sul ruolo che ti interessa."
      />
      <MarketplaceSignupCta
        audience="pharmacy"
        variant="compact"
        title="Hai una farmacia e cerchi personale?"
        lead="Registra l’account e pubblica l’annuncio nella sezione lavoro dedicata."
      />
    </div>

    <JobReminderFaq
      localItems={localFaqItems}
      localHeading={`Domande frequenti: ${roleLabel} ${locationPhrase}`}
      localLead={`Risposte utili se stai cercando lavoro come ${roleLabel.toLowerCase()} ${locationPhrase}.`}
    />
  </div>
</BaseLayout>
