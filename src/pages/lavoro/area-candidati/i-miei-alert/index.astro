---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JobSeekerAreaApp from '@/components/marketplace/JobSeekerAreaApp';
import { siteUrl } from '@/lib/turni';

const title = 'I miei alert lavoro | ProntoFarmacie';
const canonical = `${siteUrl(import.meta.env)}/lavoro/area-candidati/i-miei-alert/`;
---

<BaseLayout title={title} description="Gestione alert lavoro candidati." canonical={canonical} noindex>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <JobSeekerAreaApp client:only="react" />
  </div>
</BaseLayout>
