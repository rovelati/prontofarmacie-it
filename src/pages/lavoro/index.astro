---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPillLink from '@/components/HeroPillLink.astro';
import HeroSearchForm from '@/components/HeroSearchForm.astro';
import JobRadarSignup from '@/components/jobs/JobRadarSignup';
import SectionHero from '@/components/SectionHero.astro';
import JobReminderFaq from '@/components/JobReminderFaq.astro';
import { buildBreadcrumbJsonLd, buildFaqJsonLd } from '@/lib/seo';
import { mergeJobFaqForJsonLd } from '@/lib/jobFaq';
import { fetchJobListings, formatJobPostedLabel, jobDetailPath, jobListingPath } from '@/lib/jobs';
import { siteUrl, slugifySegment } from '@/lib/turni';
import MarketplaceSignupCta from '@/components/marketplace/MarketplaceSignupCta.astro';

const FEATURED_LIMIT = 12;
const allJobs = await fetchJobListings('tutta-italia', 'tutte');
const featuredJobs = allJobs.slice(0, FEATURED_LIMIT);
const base = siteUrl(import.meta.env);
const title = 'Offerte di lavoro in farmacia | ProntoFarmacie';
const description = `${allJobs.length} offerte di lavoro in farmacia aggiornate: Farmacista e altri ruoli, per città. Fonti Farmalavoro e Federfarma.`;
const canonical = `${base}/lavoro/`;
function mentionsSalary(job: { title?: string | null; excerpt?: string | null }) {
  const text = `${job.title || ''} ${job.excerpt || ''}`.toLowerCase();
  return text.includes('ral') || text.includes('stipendio') || text.includes('euro') || text.includes('€');
}
function sourceKey(job: { source_name?: string | null; guid?: string | null }) {
  return `${job.source_name || ''} ${job.guid || ''}`.toLowerCase();
}
const pharmacistJobs = allJobs.filter((job) => {
  return (job.category || job.title || '').toLowerCase().includes('farmacista');
});
const salaryJobs = allJobs.filter((job) => mentionsSalary(job));
const farmalavoroJobs = allJobs.filter((job) => sourceKey(job).includes('farmalavoro'));
const federfarmaJobs = allJobs.filter((job) => sourceKey(job).includes('federfarma'));
const contractStats = allJobs.reduce((acc, job) => {
  const key = job.contract_type || 'Contratto da verificare';
  acc.set(key, (acc.get(key) || 0) + 1);
  return acc;
}, new Map<string, number>());
const topContracts = [...contractStats.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4);
const cityStats = allJobs.reduce((acc, job) => {
  const city = job.pharmacy?.city;
  if (!city) return acc;
  acc.set(city, (acc.get(city) || 0) + 1);
  return acc;
}, new Map<string, number>());
const cityRoleStats = allJobs.reduce((acc, job) => {
  const citySlug = slugifySegment(job.pharmacy?.city || '');
  if (!citySlug) return acc;
  const rawRole = (job.category || '').toLowerCase().includes('magazz')
    ? 'magazziniere'
    : (job.category || '').toLowerCase().includes('dirett')
      ? 'direttore'
      : 'farmacista';
  const key = `${citySlug}|${rawRole}`;
  acc.set(key, (acc.get(key) || 0) + 1);
  return acc;
}, new Map<string, number>());
const topCities = [...cityStats.entries()].sort((a, b) => b[1] - a[1]).slice(0, 18);
const milanoFarmacistaHref = jobListingPath('milano', 'farmacista', cityRoleStats.get('milano|farmacista') || 0);
const romaFarmacistaHref = jobListingPath('roma', 'farmacista', cityRoleStats.get('roma|farmacista') || 0);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    url: canonical,
    name: title,
    description,
    inLanguage: 'it-IT',
  },
  buildBreadcrumbJsonLd([
    { name: 'Home', url: `${base}/` },
    { name: 'Lavoro', url: canonical },
  ]),
  buildFaqJsonLd(mergeJobFaqForJsonLd()),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Offerte di lavoro in farmacia',
    numberOfItems: allJobs.length,
    itemListElement: featuredJobs.map((job, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: job.title_seo || job.title,
      url: `${base}${jobDetailPath(job)}`,
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SectionHero
    eyebrow="Lavoro in farmacia"
    title="Trova lavoro come farmacista vicino a te"
    description={`${allJobs.length} offerte attive (ultimi 60 giorni) da Farmalavoro e Federfarma. Cerca per località, confronta contratto e contatti, oppure attiva un radar.`}
  >
    <HeroSearchForm
      action="/lavoro/cerca"
      inputName="city"
      placeholder="Città (es. Milano, Roma, Torino…)"
      buttonLabel="Cerca"
    />
    <HeroPillLink slot="footer" href="/lavoro-vicino-a-te/" variant="solid">Vicino a me</HeroPillLink>
    <HeroPillLink slot="footer" href="/lavoro/tutta-italia/tutte/">Tutta Italia</HeroPillLink>
    <HeroPillLink slot="footer" href={milanoFarmacistaHref}>Milano · Farmacista</HeroPillLink>
    <HeroPillLink slot="footer" href={romaFarmacistaHref}>Roma · Farmacista</HeroPillLink>
    <HeroPillLink slot="footer" href="/lavoro/inserisci-annuncio/">Pubblica annuncio</HeroPillLink>
    <HeroPillLink slot="footer" href="/lavoro/area-candidati/">Area candidati</HeroPillLink>
  </SectionHero>

  <div class="page-section space-y-6 py-8 sm:space-y-10 sm:py-12">
    <div class="grid gap-4 rounded-3xl border border-indigo-100 bg-indigo-50/50 p-5 sm:grid-cols-2 sm:p-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Per chi cerca lavoro</p>
        <h2 class="mt-1 text-lg font-bold text-gray-900">Registrati e gestisci gli alert</h2>
        <p class="mt-1 text-sm text-gray-600">Sezione dedicata ai candidati, distinta dalla ricerca turni degli utenti.</p>
        <a href="/lavoro/area-candidati/" class="mt-3 inline-flex text-sm font-semibold text-indigo-700 hover:underline">
          Vai all&apos;area candidati →
        </a>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Per le farmacie</p>
        <h2 class="mt-1 text-lg font-bold text-gray-900">Pubblica un annuncio</h2>
        <p class="mt-1 text-sm text-gray-600">Orari e servizi si gestiscono in Area farmacia; le offerte di lavoro restano qui.</p>
        <div class="mt-3 flex flex-wrap gap-3 text-sm font-semibold">
          <a href="/lavoro/inserisci-annuncio/" class="text-emerald-700 hover:underline">Inserisci annuncio →</a>
          <a href="/area-farmacia/" class="text-emerald-700 hover:underline">Area farmacia →</a>
        </div>
      </div>
    </div>
    <JobRadarSignup client:load />

    <section class="grid grid-cols-2 gap-2 sm:grid-cols-4">
      {[
        ['Annunci attivi', allJobs.length],
        ['Ruolo farmacista', pharmacistJobs.length],
        ['Farmalavoro', farmalavoroJobs.length],
        ['Federfarma', federfarmaJobs.length],
      ].map(([label, value]) => (
        <div class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm sm:p-4">
          <p class="text-[11px] font-semibold uppercase tracking-wide text-emerald-600">{label}</p>
          <p class="mt-1 text-2xl font-bold leading-none text-gray-900">{value}</p>
        </div>
      ))}
    </section>
    {salaryJobs.length > 0 && (
      <p class="text-sm text-gray-600">
        In {salaryJobs.length} annunci compare un riferimento a retribuzione/stipendio nel titolo o nell&apos;estratto.
      </p>
    )}

    <section>
      <div class="mb-4 flex flex-col gap-2 sm:mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="section-heading">Offerte da valutare adesso</h2>
          <p class="section-lead">
            Le ultime {featuredJobs.length} tra {allJobs.length} offerte pubblicate negli ultimi 60 giorni, con località e contratto in evidenza.
          </p>
        </div>
        <a href="/lavoro/tutta-italia/tutte/" class="text-sm font-semibold text-emerald-700 hover:underline">Vedi tutte →</a>
      </div>

      {featuredJobs.length > 0 ? (
        <ul class="grid gap-3 sm:grid-cols-2">
          {featuredJobs.map((job) => {
            const postedLabel = formatJobPostedLabel(job.date_posted);
            return (
            <li>
              <a href={jobDetailPath(job)} class="block h-full rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:border-emerald-300 hover:bg-emerald-50/40 sm:p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">{job.category || 'Offerta lavoro'}</p>
                <h2 class="mt-2 text-base font-semibold text-gray-900 sm:text-lg">{job.title_seo || job.title}</h2>
                <p class="mt-2 text-sm text-gray-500">
                  {[job.pharmacy?.city, job.pharmacy?.province, job.contract_type].filter(Boolean).join(' · ')}
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {postedLabel && <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">{postedLabel}</span>}
                  {job.pharmacy?.city && <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">{job.pharmacy.city}</span>}
                  {job.contract_type && <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">{job.contract_type}</span>}
                  {job.source_name && <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-800">{job.source_name}</span>}
                  {mentionsSalary(job) && (
                    <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-800">Retribuzione citata</span>
                  )}
                </div>
              </a>
            </li>
            );
          })}
        </ul>
      ) : (
        <div class="section-card text-center">
          <h2 class="text-lg font-semibold text-gray-900">Nessuna offerta disponibile al momento</h2>
          <p class="mt-2 text-sm text-gray-600">Torna più tardi oppure pubblica un annuncio se stai cercando personale.</p>
        </div>
      )}
    </section>

    <div class="grid gap-4 lg:grid-cols-2">
      <MarketplaceSignupCta
        audience="job_seeker"
        title="Non perdere le prossime offerte"
        lead="Registrati come candidato: alert su misura e spazio unico per CV e profilo, con privacy by design."
      />
      <MarketplaceSignupCta
        audience="pharmacy"
        title="Assumi dalla sezione lavoro"
        lead="Crea l’account farmacista, aggiorna la scheda e pubblica annunci dove arrivano i candidati."
      />
    </div>

    <section class="grid gap-4 lg:grid-cols-2">
      <div class="section-card">
        <h2 class="text-lg font-semibold text-gray-900">Dove stanno assumendo ora</h2>
        <p class="section-lead">Località più presenti tra gli {allJobs.length} annunci attivi.</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {topCities.length > 0 ? topCities.map(([city, count]) => (
            <a
              href={`/lavoro/${slugifySegment(city)}/tutte/`}
              class="rounded-full bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-800 hover:bg-emerald-100"
            >
              {city} · {count}
            </a>
          )) : (
            <p class="text-sm text-gray-600">Le località appariranno appena sono disponibili annunci.</p>
          )}
        </div>
      </div>

      <div class="section-card">
        <h2 class="text-lg font-semibold text-gray-900">Che tipo di contratto trovi</h2>
        <p class="section-lead">Una lettura rapida sull&apos;intero catalogo attivo.</p>
        <div class="mt-4 grid gap-2">
          {topContracts.length > 0 ? topContracts.map(([contract, count]) => (
            <div class="flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3 text-sm">
              <span class="font-medium text-gray-800">{contract}</span>
              <span class="font-semibold text-emerald-700">{count}</span>
            </div>
          )) : (
            <p class="text-sm text-gray-600">I contratti appariranno appena sono disponibili annunci.</p>
          )}
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-gray-200 bg-gray-900 p-6 text-white shadow-sm sm:p-8">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-emerald-300">Perché è diverso</p>
          <h2 class="mt-2 text-2xl font-bold">Non solo annunci: una ricerca pensata per farmacisti</h2>
          <p class="mt-3 text-sm text-gray-300">
            Chi cerca lavoro vuole capire subito distanza, contratto, stipendio quando disponibile e canale di contatto. Il radar sposta la ricerca da “torno ogni giorno sul sito” a “mi avvisi quando esce qualcosa vicino a me”.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          {[
            ['1', 'Scegli località e raggio'],
            ['2', 'Filtra per ruolo e contratto'],
            ['3', 'Apri solo offerte pertinenti'],
          ].map(([step, label]) => (
            <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
              <p class="text-sm font-bold text-emerald-300">{step}</p>
              <p class="mt-1 text-sm font-semibold">{label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="grid gap-4 lg:grid-cols-3">
      <a href="/lavoro/tutta-italia/tutte/" class="section-card hover:border-emerald-300 hover:bg-emerald-50/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Per candidati</p>
        <h2 class="mt-2 text-lg font-semibold text-gray-900">Cerca in tutta Italia</h2>
        <p class="mt-2 text-sm text-gray-600">Sfoglia gli annunci attivi per farmacisti, direttori e personale qualificato.</p>
      </a>
      <a href="/lavoro/inserisci-annuncio/" class="section-card hover:border-emerald-300 hover:bg-emerald-50/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Per farmacie</p>
        <h2 class="mt-2 text-lg font-semibold text-gray-900">Pubblica un annuncio</h2>
        <p class="mt-2 text-sm text-gray-600">Inserisci una nuova offerta e rendila visibile ai professionisti del settore.</p>
      </a>
      <a href={milanoFarmacistaHref} class="section-card hover:border-emerald-300 hover:bg-emerald-50/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-600">Ricerche frequenti</p>
        <h2 class="mt-2 text-lg font-semibold text-gray-900">Farmacista a Milano</h2>
        <p class="mt-2 text-sm text-gray-600">Accedi rapidamente alle ricerche locali più consultate.</p>
      </a>
    </section>

    <JobReminderFaq />
  </div>
</BaseLayout>
