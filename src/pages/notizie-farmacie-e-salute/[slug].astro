---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fetchNewsArticleBySlug } from '@/lib/news';
import { buildBreadcrumbJsonLd, buildNewsArticleJsonLd } from '@/lib/seo';
import { siteUrl } from '@/lib/turni';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/notizie-farmacie-e-salute/', 302);

const article = await fetchNewsArticleBySlug(slug.replace(/\/$/, ''));
if (!article) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const base = siteUrl(import.meta.env);
const canonical = `${base}/notizie-farmacie-e-salute/${article.slug}/`;
const title = `${article.title} | ProntoFarmacie`;
const description = article.excerpt.replace(/[#*<>\/]/g, ' ').slice(0, 160);
const publishedLabel = new Date(article.date).toLocaleDateString('it-IT');
const jsonLd = [
  buildNewsArticleJsonLd(base, article),
  buildBreadcrumbJsonLd([
    { name: 'Home', url: `${base}/` },
    { name: 'Notizie', url: `${base}/notizie-farmacie-e-salute/` },
    { name: article.title, url: canonical },
  ]),
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <p class="text-xs font-semibold uppercase text-emerald-600">{article.categoryGroup}</p>
    <h1 class="mt-2 text-3xl font-bold text-gray-900 sm:text-4xl">{article.title}</h1>
    <p class="mt-3 text-sm text-gray-500">
      <span>{article.author}</span>
      {' · '}
      <time datetime={article.date}>{publishedLabel}</time>
    </p>
    {article.image && (
      <img src={article.image} alt="" class="mt-6 w-full rounded-2xl object-cover" />
    )}
    <div class="prose prose-emerald mt-8 max-w-none" set:html={article.content} />
    <p class="mt-10">
      <a href="/notizie-farmacie-e-salute/" class="text-sm font-semibold text-emerald-700 hover:underline">
        ← Torna alle notizie
      </a>
    </p>
  </article>
</BaseLayout>
