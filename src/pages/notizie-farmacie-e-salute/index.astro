---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPillLink from '@/components/HeroPillLink.astro';
import SectionHero from '@/components/SectionHero.astro';
import { fetchNewsArticles, NEWS_CATEGORY_TABS } from '@/lib/news';
import { buildNewsCollectionJsonLd } from '@/lib/seo';
import { siteUrl } from '@/lib/turni';

const posts = await fetchNewsArticles({ limit: 24 });
const title = 'Notizie Farmacie e Salute | ProntoFarmacie';
const description = 'Notizie su farmacie di turno, salute, benessere e lavoro in farmacia.';
const base = siteUrl(import.meta.env);
const canonical = `${base}/notizie-farmacie-e-salute/`;
const activeTab = 'all';
const jsonLd = [buildNewsCollectionJsonLd(base, canonical, title, description, posts)];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <SectionHero
    eyebrow="Notizie e salute"
    title="Notizie farmacie e salute"
    description="Aggiornamenti su turni, prevenzione, benessere e mondo farmacia."
  >
    <HeroPillLink slot="footer" href="/farmacie-di-turno/" variant="solid">Farmacie di turno</HeroPillLink>
    <HeroPillLink slot="footer" href="/lavoro/">Offerte lavoro</HeroPillLink>
    <HeroPillLink slot="footer" href="/listafarmacie/italia/">Lista farmacie</HeroPillLink>
  </SectionHero>

  <div class="page-section">
    <nav class="flex flex-wrap gap-2">
      {NEWS_CATEGORY_TABS.map((tab) => (
        <a
          href={tab.path}
          class={`rounded-full px-4 py-2 text-sm font-semibold ${
            activeTab === tab.id
              ? 'bg-emerald-600 text-white'
              : 'border border-gray-200 bg-white text-gray-700 hover:border-emerald-300'
          }`}
        >
          {tab.label}
        </a>
      ))}
    </nav>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm hover:border-emerald-300">
          {post.image && (
            <img src={post.image} alt="" class="h-44 w-full object-cover" loading="lazy" />
          )}
          <div class="p-5">
            <p class="text-xs font-semibold uppercase text-emerald-600">{post.categoryGroup}</p>
            <h2 class="mt-2 text-lg font-bold text-gray-900">
              <a href={`/notizie-farmacie-e-salute/${post.slug}/`} class="hover:text-emerald-700">
                {post.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-gray-600 line-clamp-3">
              {post.excerpt.replace(/[#*<>\/]/g, ' ').slice(0, 160)}
            </p>
            <time class="mt-3 block text-xs text-gray-400" datetime={post.date}>
              {new Date(post.date).toLocaleDateString('it-IT')}
            </time>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
