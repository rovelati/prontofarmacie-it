---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getComplaintBySlug } from '@/lib/shop';
import { siteUrl } from '@/lib/turni';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/shop-reclami/', 302);

const complaint = getComplaintBySlug(slug);
if (!complaint) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const title = `${complaint.title} | ProntoFarmacie`;
const canonical = `${siteUrl(import.meta.env)}/shop-reclami/${slug}/`;
---

<BaseLayout title={title} description={complaint.intro} canonical={canonical}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <p class="text-sm"><a href="/shop-reclami/" class="text-emerald-700 hover:underline">← Reclami</a></p>
    <h1 class="mt-4 text-3xl font-bold text-gray-900">{complaint.title}</h1>
    <p class="mt-4 text-gray-700">{complaint.intro}</p>
    <ol class="mt-8 space-y-6">
      {complaint.steps.map((step) => (
        <li class="rounded-xl border bg-white p-5">
          <h2 class="font-semibold text-gray-900">{step.title}</h2>
          <p class="mt-2 text-gray-600">{step.content}</p>
        </li>
      ))}
    </ol>
    {complaint.contactInfo && <p class="mt-8 text-sm font-medium text-gray-800">{complaint.contactInfo}</p>}
  </article>
</BaseLayout>
