---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteUrl } from '@/lib/turni';

Astro.response.status = 404;

const base = siteUrl(import.meta.env);
const title = 'Pagina non trovata | ProntoFarmacie';
const description = 'La pagina richiesta non esiste o è stata rimossa.';
---

<BaseLayout title={title} description={description} canonical={`${base}/404/`} noindex>
  <section class="mx-auto max-w-3xl px-4 py-16 text-center">
    <h1 class="text-3xl font-bold text-gray-900">Pagina non trovata</h1>
    <p class="mt-3 text-gray-600">La risorsa richiesta non esiste o è stata rimossa.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700">
        Homepage
      </a>
      <a href="/farmacie-di-turno/" class="rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-800 hover:bg-gray-50">
        Farmacie di turno
      </a>
    </div>
  </section>
</BaseLayout>
